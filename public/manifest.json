{
  "name": "Hetul Mistry",
  "short_name": "Hetul",
  "description": "Full-Stack Developer, AI Engineer & System Architect",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#08090c",
  "background_color": "#08090c",
  "orientation": "any",
  "display_override": ["window-controls-overlay"],
  "protocol_handlers": [{ "protocol": "mailto", "url": "/newEmail?to=%s" }],
  "icons": [
    {
      "src": "/favicon-192.png",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "shortcuts": [
    {
      "name": "Start Live Session",
      "short_name": "Start Live",
      "description": "Jump direction into starting or joining a live session",
      "url": "/?startLive",
      "icons": [
        {
          "src": "https://pwabuilder.com/assets/icons/icon_192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "https://www.pwabuilder.com/assets/screenshots/screen1.png",
      "sizes": "2880x1800",
      "type": "image/png",
      "description": "PWABuilder Home Screen"
    },
    {
      "src": "https://www.pwabuilder.com/assets/screenshots/screen2.png",
      "sizes": "2880x1800",
      "type": "image/png",
      "description": "PWABuilder Report Card"
    },
    {
      "src": "https://www.pwabuilder.com/assets/screenshots/screen3.png",
      "sizes": "2880x1800",
      "type": "image/png",
      "description": "Manifest information on the Report Card"
    }
  ],
  "file_handlers": [
    {
      "action": "The url you would like to open when the user chooses to share content to your app. This URL must have code to do something with the returned file.",
      "accept": {
        "text/*": [".txt"]
      }
    }
  ],
  "prefer_related_applications": true,
  "related_applications": [
    {
      "platform": "windows",
      "url": "https://www.example-app.com",
      "id": "example.ExampleApp"
    },
    {
      "platform": "play",
      "url": "https://www.example-app-2.com"
    }
  ]
}
